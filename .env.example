# =============================================================================
# PREDICT — Predictive Maintenance CMSS
# Environment Configuration (copy to .env and adjust as needed)
# =============================================================================

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
POSTGRES_USER=predict
POSTGRES_PASSWORD=predict_dev_password
POSTGRES_DB=predict
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://predict:predict_dev_password@postgres:5432/predict

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=predict_sim
MQTT_PASSWORD=predict_sim_pass
MQTT_TELEMETRY_TOPIC=fmc150/+/telemetry
MQTT_DTC_TOPIC=fmc150/+/dtc

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SHADOW_MODE=true

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── Simulator ─────────────────────────────────────────────────────────────────
SIM_VEHICLE_COUNT=5
SIM_PUBLISH_INTERVAL=10
SIM_ANOMALY_PROBABILITY=0.05