# =============================================================================
# PREDICT — Predictive Maintenance CMSS
# Environment Configuration (copy to .env and adjust as needed)
# =============================================================================

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
POSTGRES_USER=predict
POSTGRES_PASSWORD=predict_dev_password
POSTGRES_DB=predict
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://predict:predict_dev_password@postgres:5432/predict

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=predict_sim
MQTT_PASSWORD=predict_sim_pass
MQTT_TELEMETRY_TOPIC=teltonika/+/telemetry
MQTT_DTC_TOPIC=teltonika/+/dtc

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SHADOW_MODE=true
# Rule engine ignores records older than this (the tracker buffers data when
# the car is out of coverage and burst-uploads later — stored, but never alerts).
RULE_MAX_RECORD_AGE_SECONDS=300

# ── Teltonika Bridge (FMC001 + FMC150, Codec 8/8E TCP listener) ──────────────
# Public endpoint your trackers connect to: <VPS_STATIC_IP>:5123
# (set this in the device configurator — Second Server on FMC001, Server on
# FMC150. It is NOT read by any code; the bridge simply binds BRIDGE_PORT on
# all interfaces and docker-compose publishes it.)
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=5123
BRIDGE_IDLE_TIMEOUT=300
# Device registry: comma-separated imei:model pairs. The IMEI handshake carries
# no model info, so this is how the bridge picks avl_map.<model>.json.
# EMPTY = accept any device as BRIDGE_DEFAULT_MODEL (fine for the first bench
# test — pin your real IMEI(s) afterwards).
# Example: BRIDGE_DEVICES=867648042983435:fmc001,357234561234567:fmc150
BRIDGE_DEVICES=
BRIDGE_DEFAULT_MODEL=fmc001

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws


