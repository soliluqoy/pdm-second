# =============================================================================
# PREDICT — Predictive Maintenance CMSS
# Environment Configuration (copy to .env and adjust as needed)
# =============================================================================

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
POSTGRES_USER=predict
POSTGRES_PASSWORD=predict_dev_password
POSTGRES_DB=predict
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://predict:predict_dev_password@postgres:5432/predict

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=predict_sim
MQTT_PASSWORD=predict_sim_pass
MQTT_TELEMETRY_TOPIC=teltonika/+/telemetry
MQTT_DTC_TOPIC=teltonika/+/dtc

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SHADOW_MODE=true
# Rule engine ignores records older than this (the tracker buffers data when
# the car is out of coverage and burst-uploads later — stored, but never alerts).
RULE_MAX_RECORD_AGE_SECONDS=300
# Dashboard live tiles: Redis snapshots older than this are treated as offline.
TELEMETRY_LIVE_MAX_AGE_SECONDS=300
# Offline watchdog: GREEN vehicles with no telemetry this long revert to GREY.
OFFLINE_AFTER_SECONDS=300
WATCHDOG_INTERVAL_SECONDS=60
# Timescale retention for raw sensor_readings (1m/1h aggregates kept).
READINGS_RETENTION_DAYS=365
# In-process rule cache TTL (also invalidated on rules CRUD).
RULES_CACHE_TTL_SECONDS=30

# ── Teltonika Bridge (FMC001 + FMC150, Codec 8/8E TCP listener) ──────────────
# Trackers connect to your public IP: <VPS_STATIC_IP>:5123 (set via SMS /
# Configurator — not read by the TCP bind). The bridge binds BRIDGE_PORT on
# all interfaces; docker-compose publishes it.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=5123
BRIDGE_IDLE_TIMEOUT=300
# Backend URL used by the bridge to poll IMEI→device_type (Assets register form).
BACKEND_URL=http://backend:8000
REGISTRY_REFRESH_SECONDS=60
# Optional bench override / allowlist. Leave EMPTY for normal ops — the bridge
# uses GET /api/v1/system/device-registry from registered vehicles.
# Example: BRIDGE_DEVICES=867648042983435:fmc001,357234561234567:fmc150
BRIDGE_DEVICES=
BRIDGE_DEFAULT_MODEL=fmc001

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
# Public IP/hostname shown in the Assets "SMS config helper" (copy-paste only).
# Example: VITE_TRACKER_SERVER=203.0.113.10
VITE_TRACKER_SERVER=


